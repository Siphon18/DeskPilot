{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "DeskPilot",
  "version": "0.1.0",
  "identifier": "com.deskpilot.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DeskPilot Settings & Workspaces",
        "url": "index.html",
        "width": 1180,
        "height": 760,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "fullscreen": false,
        "transparent": true,
        "visible": false
      },
      {
        "label": "launcher",
        "title": "DeskPilot Quick Launcher",
        "url": "index.html?mode=launcher",
        "width": 480,
        "height": 540,
        "resizable": false,
        "center": true,
        "fullscreen": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: https://asset.localhost; font-src 'self';"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {}
    }
  }
}
